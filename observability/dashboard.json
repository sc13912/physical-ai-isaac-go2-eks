     "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(max by (who) (label_replace(label_replace(DCGM_FI_DEV_GPU_UTIL{pod!=\"\"}, \"who\", \"$1|learning\", \"pod\", \"train-([a-z0-9]+)-.*\"), \"who\", \"$1|demo\", \"pod\", \"play-([a-z0-9]+)\")), \"who\", \"Go2 \u00b7 flat ground \u00b7 learning\", \"who\", \"go2\\\\|learning\"), \"who\", \"Go2 \u00b7 flat ground \u00b7 demo\", \"who\", \"go2\\\\|demo\"), \"who\", \"Go2 \u00b7 obstacle course \u00b7 learning\", \"who\", \"go2rough\\\\|learning\"), \"who\", \"Go2 \u00b7 obstacle course \u00b7 demo\", \"who\", \"go2rough\\\\|demo\"), \"who\", \"Go2 \u00b7 flat (long run) \u00b7 learning\", \"who\", \"go2long\\\\|learning\"), \"who\", \"Go2 \u00b7 flat (long run) \u00b7 demo\", \"who\", \"go2long\\\\|demo\"), \"who\", \"Unitree H1 \u00b7 learning\", \"who\", \"h1\\\\|learning\"), \"who\", \"Unitree H1 \u00b7 demo\", \"who\", \"h1\\\\|demo\"), \"who\", \"ANYmal-D \u00b7 learning\", \"who\", \"anymal\\\\|learning\"), \"who\", \"ANYmal-D \u00b7 demo\", \"who\", \"anymal\\\\|demo\"), \"who\", \"Unitree G1 \u00b7 learning\", \"who\", \"g1\\\\|learning\"), \"who\", \"Unitree G1 \u00b7 demo\", \"who\", \"g1\\\\|demo\")",
     "legendFormat": "{{who}}"
