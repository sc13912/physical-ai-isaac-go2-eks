{
 "title": "Isaac Lab on EKS \u2014 robots learning live",
 "uid": "isaaclab-eks",
 "schemaVersion": 39,
 "version": null,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "tags": [
  "isaaclab",
  "eks"
 ],
 "templating": {
  "list": [
   {
    "name": "DS",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Fleet",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "GPUs online",
   "description": "L40S GPUs reporting to DCGM (5 reserved g6e.4xlarge nodes).",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "count(DCGM_FI_DEV_GPU_UTIL) or vector(0)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "GPUs busy",
   "description": "GPUs with a learning or demo pod attached.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
