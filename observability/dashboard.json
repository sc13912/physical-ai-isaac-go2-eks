  {
   "id": 11,
   "type": "timeseries",
   "title": "Mean reward",
   "description": "Score per practice round. Rises as the robots learn to walk where they are told; the flat-ground run restarts every ~4 min.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(max by (robot) (isaaclab_scalar{tag=\"Train/mean_reward\"}), \"disp\", \"$1\", \"robot\", \"(.+)\"), \"disp\", \"Go2 \u00b7 flat ground\", \"robot\", \"go2\"), \"disp\", \"Go2 \u00b7 obstacle course\", \"robot\", \"go2rough\"), \"disp\", \"Go2 \u00b7 flat (long run)\", \"robot\", \"go2long\"), \"disp\", \"Unitree H1\", \"robot\", \"h1\"), \"disp\", \"ANYmal-D\", \"robot\", \"anymal\"), \"disp\", \"Unitree G1\", \"robot\", \"g1\")",
     "legendFormat": "{{disp}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": false
     },
     "color": {
      "mode": "palette-classic"
     },
     "decimals": 1
